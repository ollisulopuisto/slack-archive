# Copy to /root/.slack-archive/nas.conf (or set NAS_ARCHIVE_CONF) and fill in.
# This file is the machine-specific half; the script in the repository is not.

# Directory that holds <workspace>/slack-archive for each workspace.
ROOT="/path/to/slack-archives"

# Pin a version. `latest` would mean the nightly run silently changes what it
# is running.
IMAGE="ghcr.io/ollisulopuisto/slack-archive:VERSION"

# uid:gid the container writes as, so the archive stays owned by its owner.
RUN_AS="1000:1000"

# Extra group the process needs to read the archive tree (Synology ACL). Empty
# if POSIX mode is enough.
GROUP_ADD=""

TIMEZONE="Europe/Helsinki"

# Search-index rsync. The key must not live on a shared volume.
SYNC_KEY="/root/.ssh/slack-archive-sync"
SYNC_HOST="user@host.example"

# Public-site publish. Separate key from the index sync.
PUBLISH_DIR="/path/to/publish-work"
SITE="user@host.example:/var/www/archive"
START_CHANNEL=""
EXCLUDE_USER_FILES=""
SEARCH_EXCLUDE_USERS=""

# Media storage box sync. Uploads downloaded attachments to the storage box.
MEDIA_KEY="/root/.ssh/slack-media-sync"
MEDIA_DEST="user-subN@host.example:./"
MEDIA_PORT="23"
MEDIA_KNOWN_HOSTS=""

# Optional. A URL in this file is POSTed every four minutes so a sleeping NAS
# stays awake for the render.
HEARTBEAT_URL_FILE="/root/.nas-heartbeat-url"

# Slack tokens live here as <workspace>, not in the archive tree. The archive
# tree is often on a share; this directory must not be.
TOKEN_DIR="/root/.slack-archive/tokens"

# Optional. Read the pictures on another machine (scripts/vps-ocr.sh) instead
# of never. With OCR_HOST empty the two steps that talk to it do nothing.
#
# The NAS sends channels.json and the message files of public and private
# channels - not the direct messages - to OCR_DIR/data there, and fetches
# OCR_DIR/data/ocr.jsonl back before it builds the search indexes. Make the
# directory first (mkdir -p DIR/data); the key should be one that machine
# accepts for nothing but this.
OCR_HOST=""
OCR_KEY="/root/.ssh/slack-ocr-sync"
# Relative to the account's home directory there, and the same place WORK points
# to in vps-ocr.conf.
OCR_DIR="slack-archive-ocr"
OCR_PORT="22"
OCR_KNOWN_HOSTS=""
